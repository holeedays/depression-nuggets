{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./depression_nuggets_app/static/depression_nuggets_app/ts",
    "outDir": "./depression_nuggets_app/static/depression_nuggets_app/js",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module

    // swapped nodenext --> esnext, both use esm6 module/imports but types.d.ts file look up (for type hints) with nodenext
    // requires imports with a js extension --> "./types.js". However, jolt modules import through "./types" and this
    // maps to the types.d.ts file only because their module resolution is using "bundler". You can only set to this module
    // resolution if you're using esnext... nodenext requires a module resolution of "nodenext"
    "module": "esnext",
    // allows extensionless imports
    "moduleResolution": "bundler",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true
  }
}
